<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme while the process starts: always brand-dark, never white. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">#FF06070C</item>
        <item name="android:navigationBarColor">#FF06070C</item>
    </style>

    <!-- Window theme once the engine is up; matches the Flutter scaffold colour
         so there is no white flash between splash and first frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">#FF06070C</item>
        <item name="android:statusBarColor">#FF06070C</item>
        <item name="android:navigationBarColor">#FF06070C</item>
    </style>
</resources>
